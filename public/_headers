# Cloudflare Workers static assets (public/_headers). Later rules override earlier ones for the same header.
/missions/*.json
  Cache-Control: public, max-age=3600
/missions/index.json
  Cache-Control: public, max-age=300
/m/*
  Cache-Control: public, max-age=3600
/index.html
  Cache-Control: public, max-age=3600
